{
  "name": "firefox-tab-organizer",
  "private": true,
  "license": "MPL-2.0",
  "homepage": "https://github.com/NickReardon/firefox-tab-handler",
  "repository": {
    "type": "git",
    "url": "https://github.com/NickReardon/firefox-tab-handler.git"
  },
  "bugs": "https://github.com/NickReardon/firefox-tab-handler/issues",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "test": "node --test",
    "lint": "web-ext lint --source-dir src",
    "build": "web-ext build --source-dir src --artifacts-dir web-ext-artifacts --overwrite-dest",
    "release:check": "pnpm test && pnpm run lint && pnpm run build",
    "run": "web-ext run --source-dir src"
  },
  "devDependencies": {
    "web-ext": "^10.7.0"
  }
}
